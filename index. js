// ============================================================
// TRANSCRIPTION VOCALE
// ============================================================

async function transcrireAudio(
  audioBuffer,
  mimetype = 'audio/ogg'
) {

  if (!groq) {

    return '';

  }

  try {

    let extension = 'ogg';


    if (
      mimetype.includes('mp3') ||
      mimetype.includes('mpeg')
    ) {

      extension = 'mp3';

    } else if (
      mimetype.includes('m4a') ||
      mimetype.includes('mp4')
    ) {

      extension = 'm4a';

    } else if (
      mimetype.includes('webm')
    ) {

      extension = 'webm';

    } else if (
      mimetype.includes('wav')
    ) {

      extension = 'wav';

    }


    const file =
      await toFile(
        audioBuffer,
        `hbot2_voice.${extension}`
      );


    const transcription =
      await groq.audio.transcriptions.create({

        file,

        model:
          WHISPER_MODEL,

        language:
          WHISPER_LANGUAGE,

        response_format:
          'json',

        temperature:
          0

      });


    return (
      transcription.text?.trim() || ''
    );

  } catch (error) {

    console.error(
      '❌ Whisper :',
      error.message
    );

    return '';

  }

}


// ============================================================
// NETTOYAGE TEXTE VOCAL
// ============================================================

function nettoyerTexteVocal(
  text
) {

  return String(text || '')

    .replace(
      /\[(.*?)\]\(.*?\)/g,
      '$1'
    )

    .replace(
      /[*_~`#]/g,
      ''
    )

    .replace(
      /[\u{1F300}-\u{1FAFF}]/gu,
      ''
    )

    .trim();

}


// ============================================================
// GENERER AUDIO ELEVENLABS
// ============================================================

async function genererVocal(
  text
) {

  if (
    !VOICE_REPLY_ENABLED ||
    !ELEVENLABS_API_KEY ||
    !ELEVENLABS_VOICE_ID
  ) {

    return null;

  }


  const cleanText =
    nettoyerTexteVocal(text)
      .slice(0, 1800);


  if (!cleanText) {

    return null;

  }


  const url =
    `https://api.elevenlabs.io/v1/text-to-speech/` +
    `${encodeURIComponent(ELEVENLABS_VOICE_ID)}` +
    `?output_format=${encodeURIComponent(
      ELEVENLABS_OUTPUT_FORMAT
    )}`;


  const response =
    await fetch(
      url,
      {

        method: 'POST',

        headers: {

          'xi-api-key':
            ELEVENLABS_API_KEY,

          'Content-Type':
            'application/json',

          'Accept':
            'audio/mpeg'

        },

        body: JSON.stringify({

          text:
            cleanText,

          model_id:
            ELEVENLABS_MODEL

        })

      }
    );


  if (!response.ok) {

    const error =
      await response.text();

    throw new Error(
      `ElevenLabs ${response.status}: ` +
      error.slice(0, 300)
    );

  }


  return Buffer.from(
    await response.arrayBuffer()
  );

}


// ============================================================
// ENVOYER REPONSE VOCALE
// ============================================================

async function envoyerVocal(
  jid,
  text,
  quoted
) {

  if (!sockInstance) {

    return false;

  }

  try {

    const audio =
      await genererVocal(text);

    if (!audio) {

      return false;

    }


    const isMp3 =
      ELEVENLABS_OUTPUT_FORMAT
        .startsWith('mp3_');


    await sockInstance.sendMessage(

      jid,

      {

        audio,

        mimetype:
          isMp3
            ? 'audio/mpeg'
            : 'audio/ogg; codecs=opus',

        ptt: true

      },

      {
        quoted
      }

    );


    return true;

  } catch (error) {

    console.error(
      '❌ ElevenLabs :',
      error.message
    );

    return false;

  }

}


// ============================================================
// GENERATION REPONSE IA
// ============================================================

async function genererIA(
  jid,
  question,
  groupMemory = [],
  webData = null
) {

  if (!groq) {

    return (
      '⚠️ Le service IA Groq n’est pas configuré.'
    );

  }


  if (!conversations.has(jid)) {

    conversations.set(
      jid,
      []
    );

  }


  const history =
    conversations.get(jid);


  let memoryText =
    'Aucune mémoire de groupe pertinente.';


  if (groupMemory.length) {

    memoryText =
      groupMemory
        .map(item => {

          const date =
            item.dateISO ||
            item.date ||
            '';

          return (
            `- ${item.texte} ` +
            `(source : ${
              item.auteur || 'membre'
            }, date : ${date})`
          );

        })
        .join('\n');

  }


  let webText =
    'Aucune recherche Internet effectuée.';


  if (
    webData &&
    webData.results
  ) {

    webText = '';

    if (webData.answer) {

      webText +=
        `Résumé du moteur Internet :\n` +
        `${webData.answer}\n\n`;

    }


    webData.results.forEach(
      (item, index) => {

        webText +=
          `Source ${index + 1}:\n` +
          `Titre: ${item.title}\n` +
          `URL: ${item.url}\n` +
          `Contenu: ${item.content}\n\n`;

      }
    );

  }


  const context = `

MEMOIRE DU GROUPE :

${memoryText}


RECHERCHE INTERNET :

${webText}

`;


  history.push({

    role: 'user',

    content:
      `${context}\n\nQUESTION : ${question}`

  });


  while (
    history.length > MAX_HISTORY
  ) {

    history.shift();

  }


  try {

    const completion =
      await groq.chat.completions.create({

        model:
          GROQ_MODEL,

        messages: [

          {

            role: 'system',

            content:
              SYSTEM_PROMPT

          },

          ...history

        ],

        temperature:
          0.6,

        max_tokens:
          1200

      });


    const answer =
      completion
        .choices?.[0]
        ?.message?.content
        ?.trim();


    if (!answer) {

      return (
        'Je n’ai pas réussi à formuler une réponse.'
      );

    }


    history.push({

      role: 'assistant',

      content:
        answer

    });


    while (
      history.length > MAX_HISTORY
    ) {

      history.shift();

    }


    return answer;

  } catch (error) {

    console.error(
      '❌ Groq IA :',
      error.message
    );

    return (
      '⚠️ Je rencontre actuellement ' +
      'un problème avec mon intelligence artificielle.'
    );

  }

}


// ============================================================
// EXTRAIRE LE TEXTE
// ============================================================

function extraireTexte(
  msg
) {

  const message =
    msg?.message;

  if (!message) {

    return '';

  }


  return (
    message.conversation ||

    message.extendedTextMessage?.text ||

    message.imageMessage?.caption ||

    message.videoMessage?.caption ||

    message.documentMessage?.caption ||

    ''
  );

}


// ============================================================
// EXTRAIRE AUDIO
// ============================================================

function extraireAudio(
  msg
) {

  const message =
    msg?.message;

  if (!message) {

    return null;

  }


  if (message.audioMessage) {

    return {

      message:

        msg,

      audioMessage:

        message.audioMessage

    };

  }


  return null;

}


// ============================================================
// NORMALISER MESSAGE
// ============================================================

function normaliserMessage(
  msg
) {

  const text =
    extraireTexte(msg);


  const audio =
    extraireAudio(msg);


  const remoteJid =
    msg.key?.remoteJid || '';


  const isGroup =
    remoteJid.endsWith('@g.us');


  const sender =
    msg.key?.participant ||
    msg.key?.remoteJid ||
    '';


  return {

    text,

    audio,

    remoteJid,

    sender,

    isGroup,

    isPrivate:
      !isGroup,

    fromMe:
      Boolean(msg.key?.fromMe)

  };

}


// ============================================================
// EXTRAIRE NOM DE L'AUTEUR
// ============================================================

function getAuthorName(
  msg
) {

  return (
    msg.pushName ||
    msg.key?.participant ||
    'membre'
  );

}


// ============================================================
// VERIFIER SI HBOT2 EST APPELE
// ============================================================

function hbot2EstMentionne(
  text
) {

  return /\bhbot2\b/i.test(
    String(text || '')
  );

}


// ============================================================
// RETIRER "HBOT2" DE LA QUESTION
// ============================================================

function nettoyerQuestion(
  text
) {

  return String(text || '')

    .replace(
      /\bhbot2\b/gi,
      ''
    )

    .replace(
      /^[:,;.!?\-\s]+/,
      ''
    )

    .trim();

}


// ============================================================
// COMMANDES
// ============================================================

async function traiterCommande(
  jid,
  text,
  quoted,
  isVoice = false
) {

  const command =
    String(text || '')
      .trim()
      .toLowerCase();


  if (
    command === '!help' ||
    command === '!aide'
  ) {

    const response = `🤖 *HBOT2*

Commandes disponibles :

!help
!aide
!id
!createur
!hbot2
!resetia

Je peux également répondre aux questions
normales.

Dans un groupe, appelle-moi avec "Hbot2".

🧠 Je peux mémoriser les informations
importantes du groupe.

🎙️ Je peux comprendre les messages vocaux.

🌐 Je peux rechercher des informations
actuelles sur Internet.`;

    if (isVoice) {

      const sent =
        await envoyerVocal(
          jid,
          response,
          quoted
        );

      if (sent) return true;

    }

    await sockInstance.sendMessage(
      jid,
      {
        text: response
      },
      {
        quoted
      }
    );

    return true;

  }


  if (command === '!id') {

    const response =
      `🆔 Identifiant :\n${jid}`;

    if (isVoice) {

      const sent =
        await envoyerVocal(
          jid,
          response,
          quoted
        );

      if (sent) return true;

    }

    await sockInstance.sendMessage(
      jid,
      {
        text: response
      },
      {
        quoted
      }
    );

    return true;

  }


  if (
    command === '!createur' ||
    command === '!hbot2'
  ) {

    const response =
      `🤖 Je suis Hbot2.\n\n` +
      `👤 J'ai été conçu par ` +
      `${CREATOR_NAME}.`;

    if (isVoice) {

      const sent =
        await envoyerVocal(
          jid,
          response,
          quoted
        );

      if (sent) return true;

    }

    await sockInstance.sendMessage(
      jid,
      {
        text: response
      },
      {
        quoted
      }
    );

    return true;

  }


  if (command === '!resetia') {

    conversations.delete(jid);

    const response =
      '🧹 La mémoire de conversation temporaire ' +
      'a été réinitialisée.';

    if (isVoice) {

      const sent =
        await envoyerVocal(
          jid,
          response,
          quoted
        );

      if (sent) return true;

    }

    await sockInstance.sendMessage(
      jid,
      {
        text: response
      },
      {
        quoted
      }
    );

    return true;

  }


  return false;

}


// ============================================================
// TRAITER MESSAGE
// ============================================================

async function traiterMessage(
  msg
) {

  try {

    if (!msg?.message) {

      return;

    }


    if (msg.key?.fromMe) {

      return;

    }


    if (
      msg.key?.remoteJid ===
      'status@broadcast'
    ) {

      return;

    }


    const info =
      normaliserMessage(msg);


    const jid =
      info.remoteJid;


    if (!jid) {

      return;

    }


    const isGroup =
      info.isGroup;


    const isVoice =
      Boolean(info.audio);


    let question =
      info.text;


    // ========================================================
    // MESSAGE VOCAL
    // ========================================================

    if (isVoice) {

      console.log(
        `🎙️ Message vocal reçu de ${jid}`
      );


      try {

        const audioBuffer =
          await downloadMediaMessage(
            msg,
            'buffer',
            {},
            {
              logger:
                pino({
                  level: 'silent'
                }),

              reuploadRequest:
                sockInstance.updateMediaMessage
            }
          );


        const mimetype =
          info.audio
            ?.audioMessage
            ?.mimetype ||
          'audio/ogg';


        question =
          await transcrireAudio(
            audioBuffer,
            mimetype
          );


        if (!question) {

          await sockInstance.sendMessage(
            jid,
            {
              text:
                '🎙️ Je n’ai pas réussi à comprendre ton message vocal.'
            },
            {
              quoted: msg
            }
          );

          return;

        }


        console.log(
          `📝 Transcription : ${question}`
        );

      } catch (error) {

        console.error(
          '❌ Téléchargement audio :',
          error.message
        );

        await sockInstance.sendMessage(
          jid,
          {
            text:
              '⚠️ Je n’ai pas réussi à récupérer ton message vocal.'
          },
          {
            quoted: msg
          }
        );

        return;

      }

    }


    question =
      String(question || '')
        .trim();


    if (!question) {

      return;

    }


    // ========================================================
    // GROUPES
    // ========================================================

    if (isGroup) {

      const mentionne =
        hbot2EstMentionne(question);


      // ------------------------------------------------------
      // Si Hbot2 n'est pas appelé :
      // il observe uniquement les informations importantes.
      // ------------------------------------------------------

      if (!mentionne) {

        const important =
          await analyserInformation(
            question
          );


        if (important) {

          await memoriserGroupe(
            jid,
            question,
            getAuthorName(msg)
          );

        }


        return;

      }

    }


    // ========================================================
    // Hbot2 A ETE APPELE
    // ========================================================

    question =
      nettoyerQuestion(question);


    if (!question) {

      question =
        'Bonjour Hbot2';

    }


    // ========================================================
    // COMMANDES
    // ========================================================

    if (
      question.startsWith('!')
    ) {

      const commandeTraitee =
        await traiterCommande(
          jid,
          question,
          msg,
          isVoice
        );

      if (commandeTraitee) {

        return;

      }

    }


    // ========================================================
    // MEMOIRE GROUPE
    // ========================================================

    let groupMemory = [];


    if (isGroup) {

      groupMemory =
        await recupererMemoireGroupe(
          jid
        );

    }


    // ========================================================
    // RECHERCHE WEB
    // ========================================================

    let webData = null;


    const needsWeb =
      await questionNecessiteWeb(
        question
      );


    if (
      needsWeb &&
      TAVILY_API_KEY
    ) {

      console.log(
        `🌐 Recherche Internet : ${question}`
      );


      webData =
        await rechercherInternet(
          question
        );

    }


    // ========================================================
    // GENERER REPONSE IA
    // ========================================================

    const answer =
      await genererIA(
        jid,
        question,
        groupMemory,
        webData
      );


    // ========================================================
    // MEMORISER SI LA QUESTION CONTIENT
    // UNE INFORMATION IMPORTANTE
    // ========================================================

    if (isGroup) {

      const important =
        await analyserInformation(
          question
        );


      if (important) {

        await memoriserGroupe(
          jid,
          question,
          getAuthorName(msg)
        );

      }

    }


    // ========================================================
    // REPONSE VOCALE
    // ========================================================

    if (isVoice) {

      const sent =
        await envoyerVocal(
          jid,
          answer,
          msg
        );


      if (sent) {

        return;

      }

    }


    // ========================================================
    // REPONSE TEXTE
    // ========================================================

    await sockInstance.sendMessage(

      jid,

      {
        text:
          answer
      },

      {
        quoted:
          msg
      }

    );

  } catch (error) {

    console.error(
      '❌ Erreur traitement message :',
      error
    );

  }

}


// ============================================================
// CONNEXION WHATSAPP
// ============================================================

async function connecterWhatsApp() {

  if (reconnecting) {

    return;

  }


  reconnecting = true;


  try {

    const {
      state,
      saveCreds
    } =
      await useMultiFileAuthState(
        'auth_info_baileys_hbot2'
      );


    const {
      version
    } =
      await fetchLatestBaileysVersion();


    console.log(
      `📱 Version Baileys utilisée : ${version.join('.')}`
    );


    const sock =
      makeWASocket({

        version,

        auth:
          state,

        printQRInTerminal:
          false,

        logger:
          pino({
            level: 'silent'
          }),

        browser: [
          'Hbot2',
          'Chrome',
          '1.0.0'
        ],

        markOnlineOnConnect:
          false

      });


    sockInstance =
      sock;


    // ========================================================
    // SAUVEGARDE IDENTIFIANTS
    // ========================================================

    sock.ev.on(
      'creds.update',
      saveCreds
    );


    // ========================================================
    // EVENEMENTS CONNEXION
    // ========================================================

    sock.ev.on(
      'connection.update',
      async update => {

        const {
          connection,
          lastDisconnect,
          qr
        } = update;


        // ----------------------------------------------------
        // QR CODE
        // ----------------------------------------------------

        if (qr) {

          try {

            currentQrImage =
              await QRCode.toDataURL(
                qr
              );

            console.log(
              '📲 Nouveau QR WhatsApp disponible sur la page Web.'
            );

          } catch (error) {

            console.error(
              '❌ QR Code :',
              error.message
            );

          }

        }


        // ----------------------------------------------------
        // CONNEXION OUVERTE
        // ----------------------------------------------------

        if (
          connection ===
          'open'
        ) {

          isConnected =
            true;

          currentQrImage =
            null;

          reconnecting =
            false;

          console.log(
            '===================================='
          );

          console.log(
            '🟢 HBOT2 CONNECTÉ À WHATSAPP'
          );

          console.log(
            `👤 Créateur : ${CREATOR_NAME}`
          );

          console.log(
            `🧠 Groq : ${
              GROQ_API_KEY
                ? 'OK'
                : 'MANQUANT'
            }`
          );

          console.log(
            `🌐 Tavily : ${
              TAVILY_API_KEY
                ? 'OK'
                : 'MANQUANT'
            }`
          );

          console.log(
            `🔊 ElevenLabs : ${
              ELEVENLABS_API_KEY &&
              ELEVENLABS_VOICE_ID
                ? 'OK'
                : 'MANQUANT'
            }`
          );

          console.log(
            `🔥 Firestore : ${
              db
                ? 'OK'
                : 'MANQUANT'
            }`
          );

          console.log(
            '===================================='
          );

        }


        // ----------------------------------------------------
        // DECONNEXION
        // ----------------------------------------------------

        if (
          connection ===
          'close'
        ) {

          isConnected =
            false;

          currentQrImage =
            null;


          const statusCode =
            new Boom(
              lastDisconnect
                ?.error
            )
              ?.output
              ?.statusCode;


          const shouldReconnect =
            statusCode !==
            DisconnectReason.loggedOut;


          console.log(
            `🔴 WhatsApp déconnecté. Code : ${statusCode}`
          );


          if (
            shouldReconnect
          ) {

            console.log(
              '🔄 Reconnexion dans 5 secondes...'
            );


            reconnecting =
              false;


            setTimeout(
              () => {

                connecterWhatsApp();

              },
              5000
            );

          } else {

            reconnecting =
              false;

            console.log(
              '🚪 Session WhatsApp déconnectée.'
            );

          }

        }

      }
    );


    // ========================================================
    // MESSAGES ENTRANTS
    // ========================================================

    sock.ev.on(
      'messages.upsert',
      async ({
        messages,
        type
      }) => {

        if (
          type !==
          'notify'
        ) {

          return;

        }


        for (
          const msg
          of messages
        ) {

          await traiterMessage(
            msg
          );

        }

      }
    );


  } catch (error) {

    reconnecting =
      false;

    isConnected =
      false;

    console.error(
      '❌ Erreur connexion WhatsApp :',
      error
    );


    setTimeout(
      () => {

        connecterWhatsApp();

      },
      5000
    );

  }

}


